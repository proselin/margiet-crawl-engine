{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@modules/crawl-engine": [
        "libs/modules/crawl-engine/src"
      ],
      "@modules/crawl-engine/*": [
        "libs/modules/crawl-engine/src/*"
      ],
      "@modules/core": [
        "libs/modules/core/src"
      ],
      "@modules/core/*": [
        "libs/modules/core/src/*"
      ],
      "@shared/bullmq": [
        "libs/shared/bullmq/src"
      ],
      "@shared/bullmq/*": [
        "libs/shared/bullmq/src/*"
      ],
      "@shared/cache": [
        "libs/shared/cache/src"
      ],
      "@shared/cache/*": [
        "libs/shared/cache/src/*"
      ],
      "@shared/common": [
        "libs/shared/common/src"
      ],
      "@shared/common/*": [
        "libs/shared/common/src/*"
      ],
      "@shared/config": [
        "libs/shared/config/src"
      ],
      "@shared/config/*": [
        "libs/shared/config/src/*"
      ],
      "@shared/database": [
        "libs/shared/database/src"
      ],
      "@shared/database/*": [
        "libs/shared/database/src/*"
      ],
      "@shared/graphql": [
        "libs/shared/graphql/src"
      ],
      "@shared/graphql/*": [
        "libs/shared/graphql/src/*"
      ],
      "@shared/http": [
        "libs/shared/http/src"
      ],
      "@shared/http/*": [
        "libs/shared/http/src/*"
      ],
      "@shared/logger": [
        "libs/shared/logger/src"
      ],
      "@shared/logger/*": [
        "libs/shared/logger/src/*"
      ],
      "@shared/middlewares": [
        "libs/shared/middlewares/src"
      ],
      "@shared/middlewares/*": [
        "libs/shared/middlewares/src/*"
      ],
      "@shared/minio": [
        "libs/shared/minio/src"
      ],
      "@shared/minio/*": [
        "libs/shared/minio/src/*"
      ],
      "@shared/swagger": [
        "libs/shared/swagger/src"
      ],
      "@shared/swagger/*": [
        "libs/shared/swagger/src/*"
      ]
    }
  }
}