{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@libs/common": [
        "libs/common/src"
      ],
      "@libs/common/*": [
        "libs/common/src/*"
      ],
      "@libs/bullmq": [
        "libs/bull-module/src"
      ],
      "@libs/bullmq/*": [
        "libs/bull-module/src/*"
      ],
      "@libs/database": [
        "libs/database/src"
      ],
      "@libs/database/*": [
        "libs/database/src/*"
      ],
      "@libs/config": [
        "libs/config/src"
      ],
      "@libs/config/*": [
        "libs/config/src/*"
      ],
      "@libs/http": [
        "libs/http/src"
      ],
      "@libs/http/*": [
        "libs/http/src/*"
      ],
      "@libs/swagger": [
        "libs/swagger/src"
      ],
      "@libs/swagger/*": [
        "libs/swagger/src/*"
      ],
      "@libs/minio": [
        "libs/minio/src"
      ],
      "@libs/minio/*": [
        "libs/minio/src/*"
      ],
      "@libs/logger": [
        "libs/logger/src"
      ],
      "@libs/logger/*": [
        "libs/logger/src/*"
      ],
      "@modules/crawl-engine": [
        "libs/crawl-engine/src"
      ],
      "@modules/crawl-engine/*": [
        "libs/crawl-engine/src/*"
      ]
    }
  }
}