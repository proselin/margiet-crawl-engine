{
  "name": "@margiet-gr/crawl-engine",
  "version": "0.0.1",
  "description": "A crawling comic from nettruyen.com",
  "author": "Hung Nguyen Quoc (Proselin)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "dotenv -e .env.development -- nest start",
    "start:dev": "dotenv -e .env.development -- nest start --watch",
    "start:debug": "dotenv -e .env.development -- nest start --debug",
    "start:prod": "node dist/apps/crawl-engine/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix ",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config apps/crawl-engine/test/jest-e2e.json",
    "docker:build": "sh build.sh"
  },
  "dependencies": {
    "@apollo/client": "^3.13.5",
    "@apollo/gateway": "^2.10.0",
    "@apollo/server": "^4.11.3",
    "@apollo/subgraph": "^2.10.0",
    "@keyv/redis": "^4.3.2",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.12",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/microservices": "^11.0.12",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@supabase/supabase-js": "^2.49.3",
    "axios": "^1.8.4",
    "bullmq": "^5.44.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.1.0",
    "date-fns": "^4.1.0",
    "graphql": "^16.10.0",
    "graphql-query-complexity": "^1.0.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.4",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "keyv": "^5.3.2",
    "lodash": "^4.17.21",
    "minio": "^8.0.5",
    "nanoid": "^3.3.11",
    "nest-winston": "^1.10.2",
    "nestjs-supabase-auth": "^1.0.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.14.1",
    "redis-om": "^0.4.7",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.21",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.26",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.4",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@libs/db/db(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@modules/crawl-engine(|/.*)$": "<rootDir>/libs/crawl-engine/src/$1",
      "^@modules/modules/core(|/.*)$": "<rootDir>/libs/modules/core/src/$1",
      "^@shared/bullmq/bull-module(|/.*)$": "<rootDir>/libs/bull-module/src/$1",
      "^@shared/cache(|/.*)$": "<rootDir>/libs/cache/src/$1",
      "^@shared/common/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@shared/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@shared/graphql(|/.*)$": "<rootDir>/libs/graphql/src/$1",
      "^@shared/http(|/.*)$": "<rootDir>/libs/http/src/$1",
      "^@shared/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@shared/middlewares(|/.*)$": "<rootDir>/libs/middlewares/src/$1",
      "^@shared/minio(|/.*)$": "<rootDir>/libs/minio/src/$1"
    }
  },
  "config": {
    "puppeteer_skip_chromium_download": true
  }
}
